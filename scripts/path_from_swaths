#!/usr/bin/env python3
import click
from romea_path_tools.f2c_path_generator import PathGenerator, CurveType

CURVE_TYPE_NAMES = [ct.name for ct in CurveType]


@click.command()
@click.argument("input_path", type=click.Path(exists=True))
@click.argument("path", type=click.Path())
@click.option(
    "--format",
    "fmt",
    type=click.Choice(["v2", "v4"]),
    default="v2",
    show_default=True,
    help="output trajectory format",
)
@click.option(
    "--curve-type",
    type=click.Choice(CURVE_TYPE_NAMES),
    default="DubinsCC",
    show_default=True,
    help="turning curve type",
)
def main(input_path, path, fmt, turning_type):
    """Generate a path from a CSV or GeoJSON file containing swaths."""
    operation_width = 2.9
    # min_radius = 3.5
    min_radius = 2.0
    robot_width = 1.0
    # turning_type = "ReedsSheppHC"
    order_algo = "boustrophedon"
    order_variant = 0

    if operation_width < robot_width:
        robot_width = operation_width

    pg = PathGenerator(robot_width, operation_width, min_radius, turning_type=turning_type)

    if input_path.endswith(".csv"):
        pg.create_swaths_from_csv(input_path)
    elif input_path.endswith(".geojson"):
        pg.create_swaths_from_geojson(input_path)
    else:
        raise ValueError("Unsupported file format. Please use .csv or .geojson files.")

    # pg.route_planning(order_algo, order_variant)
    pg.path_planning()

    print(f"nb swaths: {pg.swaths.size()}")
    print(f"WGS84 origin: {pg.origin}")

    pg.path_planning()
    print(f"nb generated points: {pg.path.size()}")
    pg.export_path(path, format=fmt)


if __name__ == "__main__":
    main()
